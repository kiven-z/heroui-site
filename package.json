  "scripts": {
    "dev": "next dev",
    "serve": "pnpm dev",
    "build": "next build",
    "start": "next start",
    "preview": "pnpm start",
    "preview:build": "pnpm build && pnpm start",
    "typecheck": "tsc --noEmit",
    "lint:eslint": "eslint --cache --max-warnings 0 \"src/**/*.{js,ts,tsx}\" --fix",
    "lint:prettier": "prettier --write \"src/**/*.{js,ts,json,tsx,css,html,md}\" \"locales/**/*.yaml\"",
    "lint": "pnpm lint:eslint && pnpm lint:prettier",
    "clean:cache": "rm -rf node_modules .eslintcache .next && pnpm install",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@heroui/react": "3.2.4",
    "@heroui/styles": "3.2.4",
    "@iconify/react": "6.0.2",
    "clsx": "2.1.1",
    "i18next": "^26.4.2",
    "next": "^16.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.13",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/compat": "1.2.8",
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.25.1",
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "22.12.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "8.31.1",
    "@typescript-eslint/parser": "8.31.1",
    "eslint": "9.25.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-unused-imports": "4.1.4",
    "globals": "16.0.0",
    "postcss": "8.5.15",
    "prettier": "3.7.4",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwind-variants": "3.3.0",
    "tailwindcss": "4.3.1",
    "typescript": "5.6.3",
    "yaml-loader": "^0.9.0"
